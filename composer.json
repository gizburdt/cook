{
    "name": "gizburdt/cook",
    "description": "Opinionated package to speed up new Laravel projects",
    "keywords": ["laravel", "dev"],
    "homepage": "https://github.com/gizburdt/cook",
    "license": "MIT",
    "authors": [
        {
            "name": "Gijs Jorissen",
            "homepage": "https://gijsjorissen.nl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.0",
        "nikic/php-parser": "^5.6"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "pestphp/pest": "^5.0",
        "symfony/process": "^8.0",
        "symfony/var-dumper": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "Gizburdt\\Cook\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gizburdt\\Cook\\Test\\": "tests"
        }
    },
    "scripts": {
        "format": "vendor/bin/pint",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gizburdt\\Cook\\CookServiceProvider"
            ]
        }
    }
}
